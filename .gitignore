# ========================
# AEGIS-AI .gitignore
# ========================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/

# ---------- Virtual Environments ----------
.venv/
venv/
ENV/
env/

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- Datasets & Training Data ----------
infosys/
data/
datasets/

# ---------- Model Weights ----------
*.pt
*.pth
*.onnx
*.h5
*.tflite
*.weights
*.pb
# Exception: keep model metadata
!models/metadata.json

# ---------- Video & Media ----------
*.mp4
*.avi
*.mov
*.mkv
*.wmv
*.flv
*.webm
*.jfif
!assets/sample_clip.mp4


# ---------- YOLO / Training Runs ----------
runs/

# ---------- Coverage & Test Artifacts ----------
.coverage
coverage.xml
htmlcov/
.pytest_cache/

# ---------- Node / JS ----------
node_modules/
package-lock.json

# ---------- Snapshots & Uploads ----------
snapshots/
uploaded_video.mp4
violations.csv
alert_log.csv
alert_summary.txt

# ---------- IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- OS ----------
.DS_Store
Thumbs.db
.env
.env.local
Desktop.ini

# ---------- Streamlit ----------
.streamlit/

# ---------- Database ----------
*.sqlite
*.sqlite3
*.db
